PORT=3000
POLL_INTERVAL_SECONDS=300

# SMTP email notifications. Gmail works with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Class Notify <your-email@gmail.com>"
DEFAULT_NOTIFY_EMAIL=your-email@gmail.com

# Optional Twilio SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEFAULT_NOTIFY_PHONE=
